# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM provider/model litellm should use by default. Defaults to Groq
# since it has a free tier -- easiest for an evaluator to get working without
# a paid account. Other examples: "anthropic/claude-sonnet-4-5",
# "openai/gpt-4o-mini", "gemini/gemini-2.0-flash"
LLM_MODEL=groq/llama-3.3-70b-versatile

# Provide credentials for whichever provider LLM_MODEL points at.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Explicit ceilings enforced by the orchestrator: max model calls per
# question, max total tokens (prompt + completion, summed across calls), and
# a soft cost cap -- so a runaway loop fails loudly instead of running open.
LLM_MAX_CALLS_PER_QUESTION=5
LLM_MAX_TOKENS_PER_QUESTION=2000
LLM_MAX_COST_USD_PER_QUESTION=0.50

# Below this confidence (or intent=unknown), the orchestrator returns
# NEEDS_CLARIFICATION without running any workflow.
LLM_MIN_CONFIDENCE=0.5
